# ---------------------------------------------------------------------------
# ALMTech Business Suite — backend configuration
#
# Copy to backend/.env for local development, or set these as environment
# variables in your hosting platform. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- REQUIRED IN EVERY ENVIRONMENT ---------------------------------------

# Signs login tokens. Use a long random string; changing it logs everyone out.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- REQUIRED IN PRODUCTION (NODE_ENV=production) -------------------------

# Set to "production" on any deployed server. Controls error verbosity and
# disables request logging. Vercel sets this automatically.
NODE_ENV=development

# MongoDB connection string. REQUIRED when NODE_ENV=production — the server
# refuses to start without it and never falls back to an embedded database.
# Leave blank in local development to use the bundled embedded MongoDB.
MONGO_URI=

# The exact origin your frontend is served from, e.g. https://your-domain
# REQUIRED when NODE_ENV=production. Comma-separate only if you genuinely
# serve multiple origins. Blank in development, which allows any origin.
CORS_ORIGIN=

# --- OPTIONAL -------------------------------------------------------------

# Port the API listens on. Defaults to 5050.
PORT=5050

# How long a login stays valid. Defaults to 12h. Accepts 15m, 12h, 7d.
JWT_EXPIRES_IN=12h

# Demo seeding. Creates sample users, products, customers and suppliers with
# PUBLICLY KNOWN passwords. On by default in development; NEVER enabled
# automatically in production. Set to "true" only if you deliberately want demo
# data on a deployed instance — never on a real business database.
# Set to "false" to disable it locally too.
ENABLE_DEMO_SEED=

# First administrator for a fresh PRODUCTION database (demo seeding off).
# Used only while the database has no users at all; ignored afterwards.
# The password is never logged and never returned by any API. Minimum 10
# characters. Remove these once the account exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
