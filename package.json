{
  "name": "almtech-business-suite",
  "version": "0.1.0",
  "private": true,
  "description": "ALM Business Suite — one Node process serving the API and the built web interface",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "build": "npm --prefix frontend install --include=dev --no-audit --no-fund && npm --prefix frontend run build",
    "start": "node backend/src/server.js",
    "dev": "./start.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0"
  }
}
